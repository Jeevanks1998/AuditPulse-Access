# AuditPulse Access Portal — backend environment variables
#
# Copy this to `.env` in backend/ (or just export these in your shell)
# and fill in the values once you're ready to wire up Phase 3. Until
# AUDITPULSE_BASE_URL and AUDITPULSE_API_KEY are both set, auditpulse.py
# stays a safe no-op — every user create/update/delete still works, it
# just isn't pushed to AuditPulse.

# Base URL of the AuditPulse API, including its version prefix —
# matches AuditPulse/backend/config/settings.py's API_V1_PREFIX
# (default "/api/v1"). Example for local dev, AuditPulse on port 8000:
AUDITPULSE_BASE_URL=http://localhost:8000/api/v1

# Shared secret — must exactly match ACCESS_PORTAL_API_KEY in
# AuditPulse/backend/.env. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and set the SAME value on both sides.
AUDITPULSE_API_KEY=

# Optional: HTTP timeout (seconds) for calls to AuditPulse. Default 5.
AUDITPULSE_TIMEOUT_SECONDS=5

# --- Auth / MFA / SSO (Phase 5) ---
#
# Secret used to sign session + MFA JWTs (auth_utils.py). Falls back to an
# insecure dev string if unset, which is fine for a laptop demo but must
# be set before deploying anywhere shared. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_JWT_SECRET=

# Optional: access-token lifetime in seconds. Default 604800 (7 days).
PORTAL_ACCESS_TOKEN_TTL=604800

# Base URL of this backend, used by sso.py to build the OIDC redirect_uri.
PORTAL_BASE_URL=http://localhost:8010

# Base URL of the frontend, used by sso.py to redirect back after a
# successful SSO login.
FRONTEND_BASE_URL=http://localhost:5500

# Comma-separated list of origins allowed to call this API from a browser
# (main.py's CORSMiddleware). Should normally match FRONTEND_BASE_URL, plus
# any other origin the frontend is actually deployed at (e.g. its Vercel
# production URL). Defaults to http://localhost:5500 for local dev if unset.
# Do not leave this unset/wildcarded once both this API and the frontend
# are deployed somewhere network-reachable.
CORS_ORIGINS_RAW=http://localhost:5500
